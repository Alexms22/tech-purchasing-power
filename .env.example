# =====================================================================
# Exemplo de configuração
# =====================================================================
# Copiar este ficheiro para  docker/.env  e substituir os valores.
# O ficheiro .env NUNCA é versionado (está no .gitignore).
#
#   cp .env.example docker/.env
# =====================================================================

# --- PostgreSQL ------------------------------------------------------
DB_NAME=tech_purchasing_power
DB_USER=seu_utilizador
DB_PASSWORD=sua_password

# --- Grafana ---------------------------------------------------------
# Password do utilizador "admin" no primeiro acesso
GRAFANA_PASSWORD=sua_password_grafana

# --- RabbitMQ --------------------------------------------------------
RABBITMQ_USER=seu_utilizador_rabbit
RABBITMQ_PASSWORD=sua_password_rabbit

# --- Node-RED --------------------------------------------------------
# Chave que cifra o ficheiro flows_cred.json dentro do volume.
# Gerar uma string aleatória longa, por exemplo com:
#   openssl rand -hex 32
# ATENÇÃO: se esta chave mudar, as credenciais já guardadas no Node-RED
# deixam de poder ser lidas e têm de ser reintroduzidas.
NODE_RED_CREDENTIAL_SECRET=gerar_uma_chave_aleatoria_longa

# --- Telegram --------------------------------------------------------
# Token do bot, obtido através do @BotFather
TELEGRAM_BOT_TOKEN=000000000:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=000000000
