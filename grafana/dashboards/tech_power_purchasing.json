      "panel-5": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "Salários por País e Senioridade",
          "description": "Uma tabela analítica de resumo que cruza o país com a senioridade, exibindo o volume de vagas e os valores salariais mínimos, médios e máximos para uma consulta rápida e detalhada.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "cg1puqxn0v6rke"
                      },
                      "spec": {
                        "dataset": "",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT \r\n  \"Pais_Numbeo\" as \"País\",\r\n  \"Nivel_Experiencia\" as \"Senioridade\",\r\n  COUNT(\"Titulo_Vaga\") as \"Total de Vagas\",\r\n  ROUND(MIN(\"Salario_Euros\")::numeric, 0) as \"Salário Mínimo (€)\",\r\n  ROUND(AVG(\"Salario_Euros\")::numeric, 0) as \"Salário Médio (€)\",\r\n  ROUND(MAX(\"Salario_Euros\")::numeric, 0) as \"Salário Máximo (€)\"\r\nFROM ofertas_emprego\r\nWHERE \"Salario_Euros\" > 0\r\nGROUP BY \"Pais_Numbeo\", \"Nivel_Experiencia\"\r\nORDER BY \"Salário Médio (€)\" DESC;",
                        "sql": {
