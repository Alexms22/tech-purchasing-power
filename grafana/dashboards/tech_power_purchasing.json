                      },
                      "spec": {
                        "dataset": "",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT \r\n  \"Pais_Numbeo\" as \"País\", \r\n  COUNT(\"Titulo_Vaga\") as \"Total de Vagas\"\r\nFROM ofertas_emprego\r\nGROUP BY \"Pais_Numbeo\"\r\nORDER BY \"Total de Vagas\" DESC;",
