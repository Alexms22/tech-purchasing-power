        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Distribuição de Vagas por País",
          "description": "Mostra o volume absoluto e a percentagem de ofertas de emprego disponíveis em cada país, ajustando-se aos filtros aplicados.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
