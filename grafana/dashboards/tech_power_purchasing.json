      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Top 10 Países com Maior Poupança Anual",
          "description": "Destaca os dez mercados onde o poder de compra real é mais vantajoso, ordenando os países pela maior margem financeira que o trabalhador consegue reter ao final do ano (cruzando os salários oferecidos com o custo de vida local).",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "cg1puqxn0v6rke"
                      },
                      "spec": {
                        "dataset": "tech_purchasing_power",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT \r\n  \"Pais_Numbeo\" as \"País\", \r\n  ROUND(AVG(\"Poupança Anual Estimada (€)\")::numeric, 2) as \"Poupança Média Anual (€)\"\r\nFROM ofertas_emprego\r\nWHERE \"Poupança Anual Estimada (€)\" IS NOT NULL\r\nGROUP BY \"Pais_Numbeo\"\r\nORDER BY \"Poupança Média Anual (€)\" DESC\r\nLIMIT 10;",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
